{
  "name": "@champpower/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": { "node": "20" },
  "main": "lib/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=.env lib/index.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed:admin": "tsx --env-file=.env src/db/seedAdmin.ts"
  },
  "dependencies": {
    "@champpower/domain": "*",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.13.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
