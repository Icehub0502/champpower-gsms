{
  "name": "@champpower/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "lib/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=gsms-source --env-file=../../.env src/index.ts",
    "prebuild": "npm run build --prefix ../../packages/domain",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --env-file=../../.env lib/index.js"
  },
  "dependencies": {
    "@champpower/domain": "*",
    "@gsms/contracts": "*",
    "@gsms/db": "*",
    "@types/multer": "^1.4.13",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.7",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
