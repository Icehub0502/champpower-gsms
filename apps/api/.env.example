# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=champpower

# JWT signing secret — set a long random value, never commit the real value
JWT_SECRET=change-me

# HTTP server
PORT=4000
# Comma-free single origin (or * for dev). The web app's origin in production.
CORS_ORIGIN=http://localhost:5173

# AI proxy (apps/api/src/routes/ai.ts) — server-side only, never sent to the client
CLAUDE_API_KEY=
GEMINI_API_KEY=

# Only used by `npm run seed:admin` to create the first admin account
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
