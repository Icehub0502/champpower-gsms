{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "lib",
    "rootDir": "src",
    "types": ["node"],
    // Typecheck (and the editor) read @champpower/domain from SOURCE, through
    // the "gsms-source" condition in packages/domain/package.json — the same
    // source the dev server and the tests run. Without this, tsc resolved the
    // package's "types" entry, dist/index.d.ts, and the API could typecheck
    // green against stale declarations of rules that had already changed.
    // tsconfig.build.json clears this again: the production build must go
    // through dist.
    "customConditions": ["gsms-source"]
  },
  "include": ["src"],
  // MySQL-era files from before the PostgreSQL rewrite. They cannot compile
  // since `mysql2` and `bcrypt` left the dependencies, and none of them is
  // mounted in app.ts. This list is a QUEUE, not a settled state: a name comes
  // off it as each screen is ported, and nothing is ever added to it. If you
  // are about to add a line here, you are hiding live code from the compiler.
  "exclude": [
    "src/db",
    "src/lib/friendlyApiError.ts",
    "src/lib/ids.ts",
    "src/lib/secrets.ts",
    "src/middleware/requireAdmin.ts",
    "src/routes/ai.ts",
    "src/routes/config.ts",
    "src/routes/customers.ts",
    "src/routes/jobs.ts",
    "src/routes/masterParts.ts",
    "src/routes/models.ts",
    "src/routes/public.ts",
    "src/routes/users.ts",
    "src/routes/vehicles.ts"
  ]
}
