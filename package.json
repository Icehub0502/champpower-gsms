{
  "name": "champpower-gsms",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w packages/db",
    "db:migrate:dry": "npm run migrate:dry -w packages/db",
    "db:seed": "npm run seed -w packages/db",
    "db:codegen": "kysely-codegen --dialect postgres --out-file packages/db/src/types.ts",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build:domain": "npm run build -w packages/domain",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test -w packages/domain && npm run test -w apps/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
