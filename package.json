{
  "name": "champpower-gsms",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:domain:test": "npm run test -w packages/domain",
    "build:domain": "npm run build -w packages/domain",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "migrate": "npm run migrate -w apps/api",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test -w packages/domain"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.3"
  }
}
