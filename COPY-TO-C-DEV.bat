@echo off
rem Copies the project out of OneDrive to C:\dev\gsms.
rem Copy, not move: a move needs a handle on the folder itself, which the
rem desktop app's folder watcher and OneDrive both hold.
if not "%~1"=="go" (
  copy /y "%~f0" "%TEMP%\gsms-copy.bat" >nul
  start "" cmd /c ""%TEMP%\gsms-copy.bat" go"
  exit /b
)
cd /d C:\
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
