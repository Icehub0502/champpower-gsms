rules_version = '2';

// Collections match "DATABASE SCHEMA - Firebase.md" (POWER GROUP GSMS reference doc).
// 12 collections: jobs, vehicles, customers, models, masterParts, partBrandOptions,
// complaintTypes, editLog, jobPhotos, config, users, board.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Role lives in the ID token's custom claims, set server-side by Cloud Functions
    // (see apps/api/src/routes/users.ts) — never trust a client-writable users/{uid}
    // document for authorization, only for display info.
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // ---- 12. board/{jobId} — public, read-only waiting-room display ----
    // Read is public, no auth — that's the whole point, it's the waiting-room screen.
    // Never carries name/phone/complaints/price — see boardPayloadFor() in
    // @champpower/domain, which is the only thing allowed to shape this document.
    // TEMPORARY write rule: the schema doc's intended design is a Firestore trigger
    // Cloud Function (onJobWrite) that owns this collection exclusively. That function
    // isn't deployed yet (Blaze plan not enabled), so the web app writes it directly
    // via syncBoardEntry() for now. Tighten to `allow write: if false` once it ships.
    match /board/{jobId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---- lookup/{plateKey} — public, read-only "find my car" page reached via QR ----
    // Same shape of rule as board: read is public by design (that's the point — a
    // customer scans a QR code and types their own plate, no login), write is staff-
    // only, and the only thing allowed to shape the document is lookupPayloadFor() in
    // @champpower/domain, which deliberately excludes phone/price/notes/signatures.
    match /lookup/{plateKey} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---- 1. jobs — the main record ----
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ---- 2. vehicles ----
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- 3. customers ----
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- 4-7, 10. Catalog & shop config — staff read, admin write per the schema ----
    // TEMPORARY: write is isSignedIn() instead of isAdmin() because no Cloud Function
    // exists yet to set the role custom claim. Nobody can be isAdmin() until that
    // ships, so admin-gating these now would just lock everyone out (this happened
    // once already — see the migration log). Tighten back to isAdmin() once real
    // admin bootstrapping exists.
    match /models/{modelId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /masterParts/{partId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /partBrandOptions/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /complaintTypes/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // technicians: NOT in the canonical schema — the reference doc keeps technician
    // names inside config/main.technicians[] instead of a separate collection. This
    // collection exists only because the app was built before that doc was seen; kept
    // read/writable for now so the existing UI doesn't break, pending the migration to
    // config/main.technicians[].
    match /technicians/{techId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- 9. jobPhotos — full-size photos, one document per photo ----
    match /jobPhotos/{photoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- 11. users/{uid} — every signed-in user may read the roster, but role
    //      changes and account creation only ever happen through the Cloud Function
    //      (which also sets the matching custom claim) — a client-side write here
    //      could set its own role field without ever touching the claim, which is the
    //      actual authorization source, so it's blocked outright rather than trusted.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- 8. editLog — append-only audit trail, never editable or deletable ----
    match /editLog/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
