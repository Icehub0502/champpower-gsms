# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- database -----------------------------------------------------------
# The application connects as gsms_app, NOT as postgres. gsms_app owns nothing
# and is not a superuser, so row-level security actually applies to it — the
# owner role bypasses RLS entirely and would make every isolation test a lie.
DATABASE_URL=postgres://gsms_app:CHANGE_ME@localhost:5432/gsms

# The role the API refuses to start without. Checked against the server at boot
# (SELECT current_user, rolsuper, rolbypassrls), not guessed from the URL — a
# superuser under another name, a BYPASSRLS role, the table owner, or
# PGUSER=postgres in the environment all defeat a URL check.
DB_APP_ROLE=gsms_app

# A statement still running has lost the request that asked for it, and an idle
# transaction holds locks that block the counter. Both are capped.
PG_STATEMENT_TIMEOUT_MS=10000
PG_IDLE_TX_TIMEOUT_MS=15000

# Superuser, used only by the migration runner and the one-off role setup.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/gsms

# --- auth ---------------------------------------------------------------
# openssl rand -base64 48   (or any 48+ random bytes)
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
# Rotated on every /refresh, so this is a sliding window for anyone who uses the
# app daily. 14 days, down from 30: the shorter ceiling costs a working member
# of staff nothing and halves the window a stolen token is useful in.
JWT_REFRESH_TTL=14d

# bcrypt cost. Must match the cost the stored password hashes were made with,
# because the dummy hash used to keep the no-such-user path slow is made here.
BCRYPT_COST=10

# --- app ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Real origins only. A '*' fallback in production is a finding, not a shortcut.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of this process, as a hop count.
# 0 = none (running directly). 1 = one nginx. 2 = Cloudflare in front of nginx.
# NEVER set this to `true`: that trusts the whole X-Forwarded-For header, so
# anyone can prepend an address and get a fresh rate-limit bucket per request.
# Too low behind a proxy is the opposite failure — every request looks like it
# came from the proxy, and twenty bad passwords lock out the whole shop.
TRUST_PROXY=0

# --- files --------------------------------------------------------------
# Photos and PDFs live on disk, never in the database, and never served by
# express.static — they belong to one shop and go through an authorised route.
STORAGE_DIR=./storage

# --- import (W1 only) ---------------------------------------------------
# The old MySQL database, read-only, for the one-time master-data import.
LEGACY_MYSQL_URL=mysql://root:@localhost:3306/stock_system
