# Copy to .env.test (gitignored). Used by `npm test -w apps/api` and
# `npm run test-db:setup -w packages/db`. Must NOT point at the dev database.
# Same host/port as dev, database gsms_test. gsms_app is a cluster-wide role,
# so it has the same password as in .env.
TEST_DATABASE_URL=postgres://gsms_app:CHANGE_ME@localhost:5432/gsms_test
# Superuser, only for test setup and cleanup. Its database must be gsms_test too.
TEST_DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/gsms_test
