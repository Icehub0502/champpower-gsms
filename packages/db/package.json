{
  "name": "@gsms/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "migrate:dry": "tsx --env-file=../../.env src/migrate.ts --dry-run",
    "test-db:setup": "tsx --env-file=../../.env --env-file-if-exists=../../.env.test src/test-db-setup.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "codegen": "kysely-codegen --dialect postgres --out-file src/types.ts",
    "import:catalog": "tsx --conditions=gsms-source --env-file=../../.env src/import/catalog.ts",
    "import:catalog:dry": "tsx --conditions=gsms-source --env-file=../../.env src/import/catalog.ts --dry-run",
    "test": "vitest run"
  },
  "dependencies": {
    "@champpower/domain": "*",
    "bcryptjs": "^3.0.2",
    "kysely": "^0.28.7",
    "pg": "^8.16.3",
    "pg-connection-string": "^2.9.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "kysely-codegen": "^0.19.0",
    "tsx": "^4.20.6",
    "vitest": "^2.1.4"
  },
  "exports": {
    "./client.js": "./src/client.ts",
    "./types.js": "./src/types.ts"
  }
}
